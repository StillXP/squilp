  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "tailwindcss": "4.3.5",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0"
  }
}
